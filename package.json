{
  "name": "tool-gui-zalo",
  "version": "2.0.0",
  "description": "ToolGuiZalo Pro V2 - Nền tảng quản lý khách hàng, consent, tác vụ bền vững SQLite WAL và đồng bộ delta đa thiết bị",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node scripts/migration/migrate_json_to_sqlite.js",
    "backup": "node scripts/backup/create_backup.js",
    "restore": "node scripts/restore/restore_backup.js",
    "lint": "node --check server.js && node --check src/app.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:perf": "node --test tests/performance/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.48.0",
    "xlsx": "^0.18.5"
  }
}
