# Cấu hình môi trường ToolGuiZalo Pro V2
# Sao chép thành file `.env` khi triển khai; không commit file `.env` lên Git.

# Mạng & HTTP Server (mặc định chỉ bind 127.0.0.1 để bảo mật máy cục bộ)
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
CORS_ALLOWLIST=http://127.0.0.1:3000,http://localhost:3000
NO_AUTO_OPEN=false

# Đường dẫn dữ liệu (nên đặt ngoài thư mục cài đặt khi triển khai sản phẩm)
# DATA_DIR=C:\ProgramData\ToolGuiZalo\data
# DB_PATH=C:\ProgramData\ToolGuiZalo\data\toolguizalo.db
# UPLOADS_DIR=C:\ProgramData\ToolGuiZalo\uploads
# BACKUP_DIR=C:\ProgramData\ToolGuiZalo\backups
# USER_DATA_DIR=C:\ProgramData\ToolGuiZalo\user_data

# Bảo mật & Xác thực (thay bằng chuỗi ngẫu nhiên dài >= 32 ký tự ở production)
APP_SECRET=
BACKUP_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SEC=28800
DEVICE_TOKEN_TTL_SEC=2592000

# Tùy chọn Local Agent (browser isolation)
AGENT_ISOLATED=true
CHANNEL_MODE=web_assisted

# Tích hợp Zalo Official Account API (tùy chọn - ưu tiên nếu được cấu hình)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_APP_SECRET=
ZALO_OA_WEBHOOK_SECRET=

# Sao lưu & Lưu trữ
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
LOG_RETENTION_DAYS=30
TIMEZONE=Asia/Ho_Chi_Minh
